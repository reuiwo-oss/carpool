{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist/cjs"
  },
  "include": ["src"],
  // Testy zostają w `src` obok kodu, ale nie mają czego szukać w `dist`.
  "exclude": ["src/**/*.test.ts"]
}
