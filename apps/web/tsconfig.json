{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"],
  // Ekrany starego modelu czekają na etap 6 nietknięte. Nie prowadzi do nich
  // żadna trasa i odwołują się do roli konta, której nie ma już w sesji —
  // dlatego stoją poza kompilacją, zamiast być przepisywane na chwilę.
  "exclude": ["src/pages/legacy"]
}
