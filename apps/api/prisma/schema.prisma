generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Model danych: wycieczka
//
// Wycieczka (`Trip`) to wyjazd w obie strony tym samym składem. Auto (`Ride`)
// należy do całej wycieczki, nie do pojedynczego kursu — stąd odcinki
// (`RideLeg`) na dojazd i powrót zamiast dwóch osobnych przejazdów.
//
// Rola w wycieczce nie jest zapisywana ani w koncie, ani w uczestnictwie:
// wylicza się z danych (`deriveParticipantRoles` w pakiecie shared). Kierowca
// ma w wycieczce auto, pasażer ma rezerwację miejsca, a uczestnik bez jednego
// i drugiego szuka miejsca. Zapisane jest tylko `isOrganizer`.
// ─────────────────────────────────────────────────────────────────────────────

enum TripVisibility {
  PUBLIC
  LINK_ONLY
  PRIVATE
}

enum TripStatus {
  OPEN
  CONFIRMED
  DONE
  CANCELLED
}

enum LegDirection {
  OUTBOUND
  RETURN
}

/// Rezerwacja domyślnie dotyczy obu odcinków — jedziemy tam i z powrotem tym
/// samym składem. Jeden kierunek to wyjątek, nie reguła.
enum ReservationLegs {
  BOTH
  OUTBOUND_ONLY
  RETURN_ONLY
}

/// Prośba blokuje fotel od razu, ale pasażer jedzie dopiero po decyzji
/// kierowcy tego auta. Odmowa i rezygnacja kasują wiersz — miejsce musi
/// natychmiast wrócić do puli, a unikalne indeksy nie umieją pomijać
/// "martwych" rekordów. Ślad po decyzji zostaje w wątku rozmowy.
enum ReservationStatus {
  PENDING
  ACCEPTED
}

enum RequestStatus {
  OPEN
  FULFILLED
  EXPIRED
}

/// Zdarzenia w wątku rysują się inaczej niż zwykła wiadomość.
enum MessageKind {
  TEXT
  REQUEST
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  vehicles       Vehicle[]
  participations TripParticipant[]
  rides          Ride[]
  reservations   SeatReservation[]
  requests       RideRequest[]
  createdTrips   Trip[]            @relation("TripCreator")
  conversations  Conversation[]    @relation("PassengerConversations")
  driverThreads  Conversation[]    @relation("DriverConversations")
  messages       Message[]
}

model Vehicle {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String
  make    String
  model   String
  /// Wnętrze auta (INTERIORS w shared) — z niego wynikają liczba miejsc
  /// i kształt schematu. String, nie enum: kolejne warianty bez migracji.
  interior   String   @default("sedan")
  seatLayout Json
  createdAt  DateTime @default(now())
  rides      Ride[]
}

model Trip {
  id          String         @id @default(cuid())
  title       String
  destination String
  description String?
  /// Wyliczane z odcinków aut: najwcześniejszy wyjazd „tam" i najpóźniejszy
  /// powrót. Do pierwszego auta trzymają wartości z formularza.
  startsAt    DateTime
  endsAt      DateTime
  visibility  TripVisibility @default(PUBLIC)
  status      TripStatus     @default(OPEN)
  createdBy   User           @relation("TripCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime       @default(now())

  participants  TripParticipant[]
  rides         Ride[]
  conversations Conversation[]
}

model TripParticipant {
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String
  user   User   @relation(fields: [userId], references: [id])
  userId String
  /// Jedyna rola zapisywana wprost — reszta wylicza się z danych.
  isOrganizer Boolean  @default(false)
  joinedAt    DateTime @default(now())

  @@id([tripId, userId])
}

/// Auto w wycieczce — jedno na uczestnika, na całą wycieczkę.
model Ride {
  id        String  @id @default(cuid())
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  driver    User    @relation(fields: [driverId], references: [id])
  driverId  String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String
  /// Kopia układu z pojazdu w chwili zgłoszenia auta — późniejsza zmiana
  /// w garażu nie przestawia foteli ludziom, którzy już je zajęli.
  seatLayoutSnapshot Json
  /// Kopia wnętrza z tego samego powodu — steruje rysowaniem schematu.
  interior           String   @default("sedan")
  note               String?
  createdAt          DateTime @default(now())

  legs         RideLeg[]
  reservations SeatReservation[]

  /// Jeden uczestnik — jedno auto w wycieczce.
  @@unique([tripId, driverId])
}

model RideLeg {
  id          String       @id @default(cuid())
  ride        Ride         @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rideId      String
  direction   LegDirection
  /// Miejsce zbiórki na tym odcinku — na powrót bywa inne niż na dojazd.
  origin      String
  departureAt DateTime
  arrivalAt   DateTime?

  @@unique([rideId, direction])
}

model SeatReservation {
  id        String            @id @default(cuid())
  ride      Ride              @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rideId    String
  user      User              @relation(fields: [userId], references: [id])
  userId    String
  seatId    String
  legs      ReservationLegs   @default(BOTH)
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  // Świadomy kompromis: jeden fotel to jedna osoba na całą wycieczkę, nawet
  // gdyby ktoś chciał zająć go tylko na powrót.
  @@unique([rideId, seatId])
  @@unique([rideId, userId])
}

/// „Chcę jechać, ale nie ma jeszcze takiej wycieczki". Celowo bez powiązania
/// z wycieczką — uczestnik wycieczki bez miejsca sam w sobie jest sygnałem
/// zapotrzebowania.
model RideRequest {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  destination String
  dateFrom    DateTime
  dateTo      DateTime
  seatsNeeded Int           @default(1)
  note        String?
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
}

/// Wątek między uczestnikiem a kierowcą w kontekście wycieczki. Przeżywa
/// odmowę i usunięcie auta, więc obie strony widzą, co się wydarzyło —
/// dlatego adresem jest para osób w wycieczce, a nie rezerwacja czy auto.
model Conversation {
  id          String @id @default(cuid())
  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  passenger   User   @relation("PassengerConversations", fields: [passengerId], references: [id])
  passengerId String
  driver      User   @relation("DriverConversations", fields: [driverId], references: [id])
  driverId    String

  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tripId, passengerId, driverId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  kind           MessageKind  @default(TEXT)
  body           String
  /// Miejsce, którego dotyczy zdarzenie — do etykiety "Tył lewe" w wątku.
  seatId         String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
